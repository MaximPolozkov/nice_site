# Скопируйте в .env и заполните:  cp .env.example .env
# Подходит и .env сайта «Кодверк»: LLM_*, VK_GROUP_TOKEN, VK_GROUP_ID, SERPAPI_KEY,
# VK_NOTIFY_PEER_IDS (= VK_ADMIN_PEER_IDS), FIRST_ADMIN_PASSWORD (= ADMIN_PASSWORD).

# ===== Сайт =====
# Домен без https:// и без www. DNS-запись A должна указывать на IP сервера.
DOMAIN=kodverks.ru
SITE_TITLE=Ниши недели
# Пароль панели /admin — не короче 10 символов
ADMIN_PASSWORD=
# Случайная строка для подписи сессий. Сгенерировать: openssl rand -hex 32
SECRET_KEY=
# Ссылка на сообщество — кнопка на публичной странице (по умолчанию vk.com/club<VK_GROUP_ID>)
VK_COMMUNITY_URL=

# ===== Расписание =====
TZ=Asia/Novosibirsk
SCHEDULE_ENABLED=1
# 1 = понедельник … 7 = воскресенье
SCHEDULE_WEEKDAY=1
SCHEDULE_TIME=09:12
# 1 — бот работает на выдуманных данных (проверить сайт без ключей). В бою — 0.
DEMO_MODE=1

# ===== Источник спроса =====
# auto — Вордстат, если настроен, иначе бесплатно через VK; wordstat; vk
DEMAND_SOURCE=auto

# ===== Яндекс Вордстат API (Yandex Cloud, платно ~20 ₽ за 1000 запросов; необязательно) =====
# Сервисный аккаунт с ролью search-api.webSearch.user на каталог → API-ключ
WORDSTAT_API_KEY=
# ID каталога в Yandex Cloud (b1g…)
WORDSTAT_FOLDER_ID=
# Старый доступ по OAuth-токену api.wordstat.yandex.net — только если он у вас ещё работает
WORDSTAT_TOKEN=
# Пусто = вся Россия
WORDSTAT_REGIONS=

# ===== Нейросеть (необязательно) =====
# none — без нейросети: ниши из каталога bot/catalog.py, чек уточняется через SerpAPI
# anthropic — Claude с веб-поиском цен; openai — любой OpenAI-совместимый сервис (YandexGPT и др.)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.anthropic.com
LLM_WEB_SEARCH=1
# YandexGPT:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# LLM_API_KEY=<API-ключ сервисного аккаунта>

# ===== VK =====
VK_GROUP_ID=
# Ключ сообщества с правом «Сообщения»
VK_GROUP_TOKEN=
# Ключ пользователя VK: бесплатная оценка спроса (newsfeed.search) и пост на стену (право wall)
VK_USER_TOKEN=
# Или сервисный ключ своего приложения VK (dev.vk.ru → Мои приложения) — тоже подходит для спроса
VK_SERVICE_TOKEN=
# Ваш VK ID (через запятую, если админов несколько). Напишите сообществу хоть раз.
VK_ADMIN_PEER_IDS=
# message — отчёт админам в личку; wall — пост на стену; both — оба; file — только в базу
PUBLISH_MODE=message

# Поиск цен через SerpAPI (необязательно). Бесплатный тариф — 100 запросов в месяц
SERPAPI_KEY=
# Сколько лучших ниш уточнять за прогон: 10 × 4 недели = 40 в месяц — в пределах бесплатного тарифа
PRICE_REFRESH_TOP=10

# ===== Отбор ниш =====
CANDIDATES_PER_RUN=30
TOP_N=3
REPEAT_COOLDOWN_WEEKS=8
MIN_COMMISSION_RUB=15000
